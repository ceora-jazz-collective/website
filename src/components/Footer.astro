---
import { CONTACT_EMAIL } from '../config/variables';
const year = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <div class="site-footer__brand-inner">
        <a
          class="site-footer__logo"
          href="/"
          aria-label="Ceora Jazz Collective - Startseite"
        >
          <img
            class="site-footer__logo-img"
            src="/logo-white.svg"
            alt="Ceora Jazz Collective"
            height="60"
          />
        </a>
        <p class="site-footer__tagline">Jazz Collective Wien</p>
        <div class="site-footer__social" aria-label="Social Media">
          <a
            class="site-footer__social-link"
            href="https://www.facebook.com/CEORAJAZZ"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="CEORA auf Facebook"
          >
            <svg
              class="site-footer__social-icon"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
              ></path>
            </svg>
          </a>
          <a
            class="site-footer__social-link"
            href="https://www.youtube.com/@CEORAJazzCollectiveVienna"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="CEORA auf YouTube"
          >
            <svg
              class="site-footer__social-icon"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              fill-rule="evenodd"
              aria-hidden="true"
            >
              <path
                d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814z M9.545 15.568V8.432L15.818 12l-6.273 3.568z"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <nav class="site-footer__nav" aria-label="Footer">
      <a class="site-footer__link" href="/#about">Über uns</a>
      <a class="site-footer__link" href="/#gigs">Gigs</a>
      <a class="site-footer__link" href="/#media">Media</a>
      <a class="site-footer__link" href="/#contact">Kontakt</a>
    </nav>

    <div class="site-footer__legal">
      <p class="site-footer__copyright">
        © {year} CEORA.<br />Alle Rechte vorbehalten.<br />

        <a class="site-footer__link" href="/impressum">Impressum</a>
        {' | '}
        <a class="site-footer__link" href="/datenschutz">Datenschutz</a><br />
        <a class="site-footer__link" href={`mailto:${CONTACT_EMAIL}`}
          >{CONTACT_EMAIL}</a
        >
      </p>
    </div>

    <p class="site-footer__credit">
      Technische Umsetzung der Webseite: {' '}
      <a
        class="site-footer__link site-footer__credit-link"
        href="https://www.software-architects.com/de/"
        target="_blank"
        rel="noopener noreferrer"
      >
        software-architects.com
      </a>
    </p>
  </div>
</footer>
