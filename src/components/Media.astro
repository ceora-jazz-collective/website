---
import fs from 'node:fs';
import path from 'node:path';

type Track = {
  filename: string;
  title: string;
  src: string;
};

function titleFromFilename(filename: string) {
  let result = filename.replace(/\.[^.]+$/, '').trim();
  result = result.replace(/\s*\(.*$/, '').trim();
  return result;
}

function publicHref(filename: string) {
  return `/media/${encodeURIComponent(filename)}`;
}

const mediaDir = path.join(process.cwd(), 'public', 'media');

let tracks: Track[] = [];
try {
  const entries = fs.readdirSync(mediaDir, { withFileTypes: true });
  tracks = entries
    .filter((e) => e.isFile())
    .map((e) => e.name)
    .filter((name) => name.toLowerCase().endsWith('.mp3'))
    .sort((a, b) => a.localeCompare(b, 'de'))
    .map((filename) => ({
      filename,
      title: titleFromFilename(filename),
      src: publicHref(filename),
    }));
} catch {
  tracks = [];
}
---

<section id="media" class="bg-primary" aria-label="Media">
  <div class="section-inner">
    <h2 class="section-title">Hörbeispiele</h2>
    <p class="section-lead">
      CEORA ist eine Live-Band. Die folgenden Hörbeispiele geben einen Eindruck
      von Klang, Energie und musikalischer Handschrift des Kollektivs und sind
      als Einladung gedacht, die Musik live zu erleben.
    </p>

    {
      tracks.length ? (
        <ul class="media-audio-list">
          {tracks.map((t) => (
            <li class="media-audio-item">
              <div class="media-audio-head">
                <span class="media-track-title">{t.title}</span>
              </div>
              <audio controls preload="none" src={t.src}>
                <a href={t.src}>Audio öffnen</a>
              </audio>
            </li>
          ))}
        </ul>
      ) : (
        <p class="media-empty">
          Aktuell sind keine MP3-Hörbeispiele verfügbar.
        </p>
      )
    }

    <p class="media-social-text">
      Weitere Hörbeispiele, Videos und Konzertmitschnitte finden Sie auf unserem
      YouTube-Kanal sowie Neuigkeiten und Termine auf unserer Facebook-Seite.
    </p>
    <div class="media-social-buttons">
      <a
        class="btn btn-primary media-social-btn"
        href="https://www.youtube.com/@CEORAJazzCollectiveVienna"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="CEORA Jazz Collective auf YouTube öffnen"
      >
        <svg
          class="media-social-icon"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          fill-rule="evenodd"
          aria-hidden="true"
        >
          <path
            d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814z M9.545 15.568V8.432L15.818 12l-6.273 3.568z"
          ></path>
        </svg>
        YouTube-Kanal besuchen
      </a>
      <a
        class="btn btn-primary media-social-btn"
        href="https://www.facebook.com/CEORAJAZZ"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="CEORA Jazz Collective auf Facebook öffnen"
      >
        <svg
          class="media-social-icon"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
          ></path>
        </svg>
        Facebook-Seite besuchen
      </a>
    </div>
  </div>
</section>

<script>
  document.addEventListener(
    'play',
    function (e) {
      var audios = document.getElementsByTagName('audio');
      for (var i = 0, len = audios.length; i < len; i++) {
        if (audios[i] != e.target) {
          audios[i].pause();
        }
      }
    },
    true,
  );
</script>
